# Auth.js
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# Shared PostgreSQL database (Neon, Supabase, Prisma Postgres, Vercel Postgres, etc.)
DATABASE_URL=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# X (Twitter) OAuth 2.0
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Instagram OAuth
AUTH_INSTAGRAM_ID=
AUTH_INSTAGRAM_SECRET=

# Vercel Blob uses project-linked OIDC on supported Vercel stores.
# For legacy stores, set BLOB_READ_WRITE_TOKEN in the Vercel project.
